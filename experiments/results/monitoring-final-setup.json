        "metricDescriptor": {
          "name": "projects/ridepulse-dcs-2026/metricDescriptors/logging.googleapis.com/user/ridepulse_api_latency_ms",
          "labels": [
            {
              "key": "endpoint",
              "description": "Bounded API path"
            }
          ],
          "metricKind": "DELTA",
          "valueType": "DISTRIBUTION",
          "unit": "ms",
          "type": "logging.googleapis.com/user/ridepulse_api_latency_ms"
        },
        "valueExtractor": "EXTRACT(jsonPayload.latency_ms)",
        "labelExtractors": {
          "endpoint": "EXTRACT(jsonPayload.path)"
        },
        "bucketOptions": {
          "exponentialBuckets": {
            "numFiniteBuckets": 25,
            "growthFactor": 1.8,
            "scale": 1
          }
        },
        "createTime": "2026-11-15T06:43:46.205132216Z",
        "updateTime": "2026-11-15T06:43:46.205132216Z",
        "resourceName": "projects/ridepulse-dcs-2026/metrics/ridepulse_api_latency_ms"
