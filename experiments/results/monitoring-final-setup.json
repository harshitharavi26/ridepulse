  "alerts": [
    {
      "status": 200,
      "body": {
        "name": "projects/ridepulse-dcs-2026/alertPolicies/9381569990122497946",
        "displayName": "RidePulse API p95 above 1 second",
        "combiner": "OR",
        "creationRecord": {
          "mutateTime": "2026-11-15T06:43:48.423702176Z",
          "mutatedBy": "shpa6505@colorado.edu"
        },
        "mutationRecord": {
          "mutateTime": "2026-11-15T06:43:48.423702176Z",
          "mutatedBy": "shpa6505@colorado.edu"
        },
        "conditions": [
          {
            "conditionThreshold": {
              "filter": "metric.type=\"logging.googleapis.com/user/ridepulse_api_latency_ms\" AND resource.type=\"cloud_run_revision\"",
              "comparison": "COMPARISON_GT",
              "thresholdValue": 1000,
              "duration": "300s",
              "trigger": {
                "count": 1
              },
              "aggregations": [
                {
                  "alignmentPeriod": "300s",
                  "perSeriesAligner": "ALIGN_PERCENTILE_95",
                  "crossSeriesReducer": "REDUCE_MAX",
                  "groupByFields": [
                    "metric.label.endpoint"
                  ]
                }
              ]
            },
            "displayName": "RidePulse API p95 above 1 second",
            "name": "projects/ridepulse-dcs-2026/alertPolicies/9381569990122497946/conditions/9381569990122497795"
          }
        ],
        "documentation": {
          "content": "RidePulse: inspect structured request/task logs and RUNBOOK.md. Missing data during planned shutdown is not an error.",
          "mimeType": "text/markdown"
        },
        "notificationChannels": [
          "projects/ridepulse-dcs-2026/notificationChannels/8100452739801605441"
        ],
        "enabled": true,
        "alertStrategy": {
          "autoClose": "1800s"
        }
      }
    },
