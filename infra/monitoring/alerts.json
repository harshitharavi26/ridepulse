[
  {
    "displayName": "RidePulse API p95 above 1 second",
    "combiner": "OR",
    "enabled": true,
    "notificationChannels": [
      "projects/ridepulse-dcs-2026/notificationChannels/8100452739801605441"
    ],
    "conditions": [
      {
        "displayName": "RidePulse API p95 above 1 second",
        "conditionThreshold": {
          "duration": "300s",
          "trigger": {
            "count": 1
          },
          "comparison": "COMPARISON_GT",
          "filter": "metric.type=\"logging.googleapis.com/user/ridepulse_api_latency_ms\" AND resource.type=\"cloud_run_revision\"",
          "thresholdValue": 1000,
          "aggregations": [
            {
              "alignmentPeriod": "300s",
              "perSeriesAligner": "ALIGN_PERCENTILE_95",
              "crossSeriesReducer": "REDUCE_MAX",
              "groupByFields": [
                "metric.label.endpoint"
              ]
            }
          ]
        }
      }
    ],
    "alertStrategy": {
      "autoClose": "1800s"
    },
    "documentation": {
      "content": "RidePulse: inspect structured request/task logs and RUNBOOK.md. Missing data during planned shutdown is not an error.",
      "mimeType": "text/markdown"
    }
  },
  {
    "displayName": "RidePulse worker retryable errors above 5%",
    "combiner": "OR",
    "enabled": true,
    "notificationChannels": [
      "projects/ridepulse-dcs-2026/notificationChannels/8100452739801605441"
    ],
    "conditions": [
      {
        "displayName": "RidePulse worker retryable errors above 5%",
        "conditionThreshold": {
          "duration": "300s",
          "trigger": {
            "count": 1
          },
          "comparison": "COMPARISON_GT",
          "filter": "metric.type=\"logging.googleapis.com/user/ridepulse_worker_errors\" AND resource.type=\"cloud_run_revision\"",
          "denominatorFilter": "metric.type=\"logging.googleapis.com/user/ridepulse_worker_tasks\" AND resource.type=\"cloud_run_revision\"",
          "thresholdValue": 0.05,
          "aggregations": [
            {
              "alignmentPeriod": "300s",
              "perSeriesAligner": "ALIGN_RATE",
              "crossSeriesReducer": "REDUCE_SUM"
            }
          ],
          "denominatorAggregations": [
            {
              "alignmentPeriod": "300s",
              "perSeriesAligner": "ALIGN_RATE",
              "crossSeriesReducer": "REDUCE_SUM"
            }
          ]
        }
      }
    ],
    "alertStrategy": {
      "autoClose": "1800s"
    },
    "documentation": {
      "content": "RidePulse: inspect structured request/task logs and RUNBOOK.md. Missing data during planned shutdown is not an error.",
      "mimeType": "text/markdown"
    }
  }
]
